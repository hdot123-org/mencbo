{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MenCbo",
  "version": "0.2.1",
  "identifier": "com.mencbo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "panel",
        "title": "MenCbo",
        "url": "index.html",
        "width": 360,
        "height": 480,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQjg4RTVEQjkwMEZDQzQKUldURS9BQzVYWTY0enZGdGRxaytMdHArcWlqRFJaN3J1RWdwZG1qbXFxWVRyVnlhNXp1T3E5N0oK",
      "endpoints": [
        "https://github.com/hdot123-org/mencbo/releases/latest/download/latest.json"
      ]
    }
  }
}
